create table icca_audits(
    -- adt
    id                  number        generated by default on null as identity    not null
  , code                varchar2(50)                                              not null
  , audit_date          date
  , active              varchar2(1)   default 'Y'                                 not null
  , cnt_id              number                                                    not null
  , cln_id              number                                                    not null
  , type                varchar2(255)                                             not null
  , activate            varchar2(1)   default 'Y'                                 not null  
  , audit_completed     varchar2(1)   default 'N'                                 not null
  , signature_image_id  number
  , created_date        date          default sysdate                             not null
  , created_by          varchar2(50)                                              not null
  , modified_date       date          
  , modified_by         varchar2(50)
);

alter table icca_audits add constraint icca_adt_pk primary key (id);
alter table icca_audits add constraint icca_adt_cnt_fk1 foreign key(cnt_id) references icca_clients(id);
alter table icca_audits add constraint icca_adt_cln_fk2 foreign key(cln_id) references icca_client_locations(id);
alter table icca_audits add constraint icca_adt_doc_fk3 foreign key(signature_image_id) references icca_documents(id);

create sequence icca_adt_code_seq
    start with 2000
    increment by 1
    nocache
    nocycle;