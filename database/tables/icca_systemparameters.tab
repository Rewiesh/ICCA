create table icca_systemparameters(
    -- syp
    id                  number        generated by default on null as identity    not null
  , parameter_name      varchar2(100)                       not null
  , parameter_value     varchar2(4000)
  , description         varchar2(500)
  , is_active           varchar2(1)   default 'Y'                                 not null
  , created_by          varchar2(100)
  , created_date        date          default sysdate     not null
  , modified_by         varchar2(100)
  , modified_date       date
);

alter table icca_systemparameters add constraint icca_syp_pk primary key (id);
alter table icca_systemparameters add constraint icca_syp_uk unique (parameter_name);
alter table icca_systemparameters add constraint icca_syp_is_active_ck check (is_active in ('Y', 'N'));
alter table icca_systemparameters add constraint icca_syp_created_by_nn check (created_by is not null);
alter table icca_systemparameters add constraint icca_syp_created_date_nn check (created_date is not null);
alter table icca_systemparameters add constraint icca_syp_modified_by_nn check (modified_by is not null);
alter table icca_systemparameters add constraint icca_syp_modified_date_nn check (modified_date is not null);

-- seed initial parameter voor fase 3 (queue systeem)
insert into icca_systemparameters (
    parameter_name
  , parameter_value
  , description
  , modified_by
  , modified_date
) values (
    'PDF_GENERATION_MODE'
  , 'REALTIME'
  , 'PDF generatie mode: REALTIME of QUEUE (voor fase 3)'
  , user
  , sysdate
);

commit;
